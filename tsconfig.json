{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "lib": ["ES2020","DOM"],
      "types": ["node"],
      "strict": false,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "outDir": "./dist",
      "rootDir": "./",
      "baseUrl": ".",
      "paths": {
        "@pages/*": ["src/pages/*"],
        "@steps/*": ["src/steps/*"],
        "@utils/*": ["src/utils/*"]
      }
    },
    "include": ["src/**/*", "features/**/*"],
    "exclude": ["node_modules", "dist"]
  }