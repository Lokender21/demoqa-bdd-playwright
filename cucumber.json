{
    "default": {
      "require": [
        "src/hooks/hooks.ts",
        "src/steps/**/*.ts"
      ],
      "requireModule": [
        "ts-node/register"
      ],
      "format": [
        "progress-bar",
        "json:reports/cucumber-report.json"
      ],
      "formatOptions": {
        "snippetInterface": "async-await"
      },
      "paths": [
        "features/login.feature",
        "features/form.feature",
        "features/elements.feature"
      ],
      "publishQuiet": true
    }
  }